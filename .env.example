# Copy to .env.local (development) or set in your host's environment (production).

# ── Email (Resend) ────────────────────────────────────────────────────
# Required for the contact form and newsletter. Without it, both forms show
# an honest "not connected" message with an email fallback.
RESEND_API_KEY=
# Sender. The domain must be verified in Resend.
RESEND_FROM="RaaVon <contact@raavon.com>"
# Inbox that receives enquiries and new-subscriber notices.
CONTACT_INBOX=contact@raavon.com

# ── Admin console (/admin) ────────────────────────────────────────────
ADMIN_PASSWORD=
# Signs admin sessions and unsubscribe links. Use a long random string,
# for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
